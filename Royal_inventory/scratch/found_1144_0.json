    "ReplacementContent": "            <!-- Main content area: list of locations and allocations -->\n            <div id=\"operational-locations-list\" style=\"display:flex; flex-direction:column; gap:20px;\">\n              <!-- Loaded dynamically -->\n            </div>\n          </div>\n\n          <!-- Tab 8: Laundry Node Status (NEW) -->\n          <div id=\"explorer-laundry-node-tab-content\" style=\"display:none;\">\n            <div style=\"display:grid; grid-template-columns: 1.5fr 1fr; gap:20px; margin-bottom:20px; text-align:right;\">\n              <!-- Right: Outstanding Items at Laundry -->\n              <div class=\"table-card\" style=\"padding:20px;\">\n                <h4 style=\"font-size:14px; font-weight:800; color:var(--text-main); margin:0 0 12px 0; border-bottom:1px solid #f1f5f9; padding-bottom:8px;\">\n                  <i class=\"fa-solid fa-hourglass-half\" style=\"color:var(--primary);\"></i> بياضات معلقة قيد الغسيل حالياً (الرصيد المتبقي هناك)\n                </h4>\n                <div style=\"overflow-x: auto; border:1px solid var(--card-border); border-radius:12px;\">\n                  <table style=\"width:100%; border-collapse:collapse; font-size:12px;\">\n                    <thead>\n                      <tr style=\"background:#f8fafc;\">\n                        <th style=\"padding:10px;\">كود الصنف</th>\n                        <th style=\"padding:10px;\">اسم الصنف</th>\n                        <th style=\"padding:10px; text-align:center;\">المرسل الكلي</th>\n                        <th style=\"padding:10px; text-align:center;\">المستلم (المرتجع)</th>\n                        <th style=\"padding:10px; text-align:center;\">المتبقي هناك</th>\n                      </tr>\n                    </thead>\n                    <tbody id=\"laundry-node-outstanding-body\">\n                      <!-- Loaded dynamically -->\n                    </tbody>\n                  </table>\n                </div>\n              </div>\n\n              <!-- Left: Actions & Summary -->\n              <div class=\"table-card\" style=\"padding:20px; display:flex; flex-direction:column; gap:12px;\">\n                <h4 style=\"font-size:14px; font-weight:800; color:var(--text-main); margin:0 0 8px 0; border-bottom:1px solid #f1f5f9; padding-bottom:8px;\">\n                  <i class=\"fa-solid fa-soap\" style=\"color:var(--primary);\"></i> إجراءات سريعة مع المغسلة\n                </h4>\n                <p style=\"font-size:11px; color:var(--text-muted); line-height:1.6; margin:0;\">\n                  يمكنك إرسال شحنة بياضات متسخة جديدة للمغسلة من رصيد هذا المستودع، أو التحقق من المرتجعات المؤكدة.\n                </p>\n                <div style=\"display:flex; gap:10px; margin-top:5px;\">\n                  <button class=\"btn\" onclick=\"openNewTransferModal()\" style=\"font-size:12px; padding:10px 15px;\">\n                    <i class=\"fa-solid fa-paper-plane\"></i> إرسال بياضات للمغسلة\n                  </button>\n                </div>\n              </div>\n            </div>\n\n            <!-- Bottom: Recent Transactions with Laundry -->\n            <div class=\"table-card\" style=\"padding:20px; text-align:right;\">\n              <h4 style=\"font-size:14px; font-weight:800; color:var(--text-main); margin:0 0 12px 0; border-bottom:1px solid #f1f5f9; padding-bottom:8px;\">\n                <i class=\"fa-solid fa-list-check\" style=\"color:var(--primary);\"></i> سجل حركات الشحن والاستلام مع المغسلة\n              </h4>\n              <div style=\"overflow-x: auto; border:1px solid var(--card-border); border-radius:12px;\">\n                <table style=\"width:100%; border-collapse:collapse; font-size:12px;\">\n                  <thead>\n                    <tr style=\"background:#f8fafc;\">\n                      <th style=\"padding:10px;\">رقم الحركة</th>\n                      <th style=\"padding:10px;\">نوع المعاملة</th>\n                      <th style=\"padding:10px;\">تفاصيل الحالة</th>\n                      <th style=\"padding:10px;\">الملاحظات والخدمة</th>\n                      <th style=\"padding:10px;\">تاريخ الإنشاء</th>\n                    </tr>\n                  </thead>\n                  <tbody id=\"laundry-node-history-body\">\n                    <!-- Loaded dynamically -->\n                  </tbody>\n                </table>\n              </div>\n            </div>\n          </div>",
