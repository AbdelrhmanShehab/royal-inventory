				{
					"name": "إضافة مجلد افتراضي للشجرة (Create Parent Node)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"groupId\": 1,\n    \"parentNodeId\": 1,\n    \"nodeNameAr\": \"مطابخ قرية جاردن الغربية\",\n    \"nodeType\": \"parent\",\n    \"comsysStoreCode\": null,\n    \"managerName\": \"مشرف المجلد\",\n    \"isActive\": true\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
