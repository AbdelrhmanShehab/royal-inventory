							"mode": "raw",
							"raw": "{\n    \"fromNodeId\": 2,\n    \"toNodeId\": 3,\n    \"notes\": \"تحويل مستعجل لسد نقص المطبخ الشرقي\",\n    \"reason\": \"تحويل داخلي تشغيلي\",\n    \"lines\": [\n        {\n            \"itemCode\": \"10101\",\n            \"quantity\": 2.0000,\n            \"unitCode\": \"01\",\n            \"unitCost\": 150.0000\n        }\n    ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/transactions/transfers",
