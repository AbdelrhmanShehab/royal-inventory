{
	"info": {
		"_postman_id": "7f8b9e6a-5c3b-4b2a-8d1e-9f0a7b6c5d4e",
		"name": "Inventory Tracking System (نظام تتبع المخزون)",
		"description": "API collection for managing custom warehouse hierarchies, pulling Comsys live stock, and posting internal transfers.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. المصادقة وتوقيع الدخول (Authentication)",
			"item": [
				{
					"name": "تسجيل الدخول (Login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.accessToken) {",
									"    pm.environment.set(\"token\", jsonData.data.accessToken);",
									"    console.log(\"Token saved successfully:\", jsonData.data.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"Admin@1234\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "تسجيل دخول مدير النظام. تقوم الدالة بحفظ توكن المصادقة تلقائياً في بيئة العمل لاستخدامه في الطلبات الأخرى."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. إدارة المزامنة وقراءة البيانات (Sync & Master Data)",
			"item": [
				{
					"name": "تشغيل المزامنة للأرصدة من كومسيس (Trigger Sync)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"division\": \"fb\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/sync/run",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"sync",
								"run"
							]
						},
						"description": "تشغيل عملية سحب الأرصدة والبيانات الفعلية من كومسيس وتحديث المخزون التشغيلي المحلي."
					},
					"response": []
				},
				{
					"name": "جلب مخازن كومسيس المتاحة (Get Active Warehouses)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/warehouses?division=fb",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"warehouses"
							],
							"query": [
								{
									"key": "division",
									"value": "fb",
									"description": "نوع النشاط (f&b or gs)"
								}
							]
						},
						"description": "جلب قائمة المستودعات الفعالة والمتاحة في كومسيس للربط بالشجرة."
					},
					"response": []
				},
				{
					"name": "جلب الأصناف النشطة (Get Master Items)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/master-data/items?division=fb",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"master-data",
								"items"
							],
							"query": [
								{
									"key": "division",
									"value": "fb"
								}
							]
						},
						"description": "جلب قائمة الأصناف والمنتجات الفعالة المسحوبة من كومسيس لاستخدامها بالتحويلات."
					},
					"response": []
				}
			]
		},
