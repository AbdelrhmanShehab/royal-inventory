							"mode": "raw",
							"raw": "{\n    \"groupId\": 1,\n    \"parentNodeId\": 1,\n    \"nodeNameAr\": \"مطبخ بار الشاطئ الفعلي\",\n    \"nodeType\": \"child\",\n    \"comsysStoreCode\": \"108\",\n    \"managerName\": \"أمين عهدة البار\",\n    \"isActive\": true,\n    \"division\": \"fb\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/hierarchy/nodes",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"hierarchy",
								"nodes"
							]
						},
						"description": "ربط مستودع حقيقي من كومسيس بعقدة نهائية (Child) تابعة لمجلد افتراضي."
					},
					"response": []
				},
				{
					"name": "عرض أرصدة عقدة معينة تفصيلياً (Get Node Stock & Items)",
